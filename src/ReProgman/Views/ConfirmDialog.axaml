<v:Win31DialogWindow xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:v="using:ReProgman.Views"
                     xmlns:w31="using:ReProgman.Win31"
                     xmlns:app="using:ReProgman"
                     x:Class="ReProgman.Views.ConfirmDialog">
  <w31:DialogShell x:Name="Shell" Padding="16,14">
    <StackPanel Spacing="14" MinWidth="260" MaxWidth="400">
      <TextBlock x:Name="MessageText"
                 HorizontalAlignment="Center"
                 FontSize="{StaticResource Win31SystemFontSize}"
                 FontWeight="Bold"
                 TextWrapping="Wrap" />
      <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="8">
        <Button x:Name="YesButton" Content="{x:Static app:Strings.ButtonYes}" IsDefault="True" />
        <Button x:Name="NoButton" Content="{x:Static app:Strings.ButtonNo}" />
      </StackPanel>
    </StackPanel>
  </w31:DialogShell>
</v:Win31DialogWindow>
